# Copy this file to .env.development and adjust values as needed.

# Django
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=django-insecure-changeme-replace-in-production
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Database (SQLite for local dev, Postgres for Docker)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://guitar0:password@localhost:5432/guitar0

# App metadata (optional, set by CI in production)
VERSION=1.0.0-dev
GIT_SHA=local

GOOGLE_CLIENT_ID=000000000000-changeme.apps.googleusercontent.com

GOOGLE_PLAY_PACKAGE_NAME=net.guitar0.app
GOOGLE_PLAY_SERVICE_ACCOUNT_INFO='{"type":"service_account","project_id":"changeme","private_key_id":"changeme","private_key":"-----BEGIN PRIVATE KEY-----\nCHANGEME\n-----END PRIVATE KEY-----\n","client_email":"changeme@changeme.iam.gserviceaccount.com","client_id":"000000000000000000000","token_uri":"https://oauth2.googleapis.com/token"}'

APPLE_BUNDLE_ID=net.guitar0.app
APPLE_APP_APPLE_ID=0000000000
